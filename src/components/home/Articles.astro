---
import { getCollection } from 'astro:content';
import { formatArticleDate } from '@/utils/date';

const articles = (
  await getCollection(
    'articles',
    ({ data }) => data.featured && !data.draft,
  )
)
  .sort(
    (a, b) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
  )
  .slice(0, 3);
---

<section id="artigos" aria-labelledby="articles-title" class="bg-secondary py-24 lg:py-32"> 
  <div class="m-container">
    <header>
      <span
        class="
          font-body
          text-xs
          font-semibold
          uppercase
          tracking-[0.14em]
          text-white/80
        "
      >
        05 / Artigos
      </span>

      <h2
        id="articles-title"
        class="
          mt-6
          font-heading
          text-3xl
          font-bold
          text-white
          md:text-4xl
        "
      >
        Artigos em destaque
      </h2>
    </header>

    <div
      class="
        mt-16
        grid
        grid-cols-1
        gap-x-8
        gap-y-14
        md:grid-cols-2
        lg:grid-cols-3
      "
    >
      {
        articles.map((article) => (
          <article class="group">
            <a
              href={`/artigos/${article.id}`}
              class="block"
            >
              <div
                class="
                  relative
                  aspect-[4/3]
                  overflow-hidden
                  bg-white/5
                "
              >
                <img
                  src={article.data.cover}
                  alt=""
                  loading="lazy"
                  class="
                    h-full
                    w-full
                    object-cover
                    transition-transform
                    duration-500
                    ease-out
                    group-hover:scale-[1.035]
                  "
                />

                <div
                  class="
                    pointer-events-none
                    absolute
                    inset-0
                    bg-black/0
                    transition-colors
                    duration-500
                    group-hover:bg-black/10
                  "
                />
              </div>

              <h3
                class="
                  mt-6
                  max-w-[95%]
                  font-heading
                  text-xl
                  font-semibold
                  leading-[1.3]
                  text-white
                  transition-colors
                  duration-300
                  group-hover:text-white/75
                "
              >
                {article.data.title}
              </h3>

              <div
                class="
                  mt-5
                  flex
                  flex-wrap
                  items-center
                  gap-2
                  font-body
                  text-[11px]
                  font-medium
                  uppercase
                  tracking-[0.08em]
                "
              >
                <span class="text-accent">
                  {article.data.category}
                </span>

                <span
                  aria-hidden="true"
                  class="text-white/25"
                >
                  |
                </span>

                <time datetime={article.data.publishedAt.toISOString()}>
                  { formatArticleDate(article.data.publishedAt) }
                </time>
              </div>
            </a>
          </article>
        ))
      }
    </div>

    <div class="mt-14 flex justify-end">
      <a
        href="/artigos"
        class="
          group
          inline-flex
          items-center
          gap-2
          font-body
          text-sm
          font-semibold
          text-white/70
          transition-colors
          duration-300
          hover:text-white
        "
      >
        <span>Ver todos os artigos</span>

        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="
            h-4
            w-4
            transition-transform
            duration-300
            group-hover:translate-x-1
          "
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</section>