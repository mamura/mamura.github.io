---
interface Props {
  slot: string;
}

const { slot } = Astro.props;
---

<div class="article-ad">
  <span class="article-ad__label">Publicidade</span>

  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-3431355971358033"
    data-ad-slot={slot}
    data-ad-format="auto"
    data-full-width-responsive="true"
  ></ins>
</div>

<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>