---
import MobileMenu from './MobileMenu';

const navigation = [
  { label: 'Projetos', href: '#projetos' },
  { label: 'Especialidades', href: '#especialidades' },
  { label: 'Artigos', href: '#artigos' },
  { label: 'Sobre', href: '#sobre' },
  { label: 'Ferramentas', href: '/ferramentas/' },
];
const isToolsPage = Astro.url.pathname.startsWith('/ferramentas');
const items = navigation.map((item) => ({
  ...item,
  href: isToolsPage && item.href.startsWith('#') ? `/${item.href}` : item.href,
}));
---

<header class="relative z-30 w-full bg-primary border-b border-white/[0.08] shadow-[0_6px_18px_rgba(0,0,0,0.08)]">
  <div class="m-container flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2 text-2xl font-bold text-white" aria-label="Mamura - Página Inicial">
      <div class="flex items-center justify-center p-4">
        <img src="/images/logo.svg" alt="Mamura" class="h-[clamp(28px,4vw,35px)] w-auto max-w-[200px] object-contain" />
      </div>      
    </a>

    <nav aria-label="Navegação principal" class="hidden items-center gap-10 text-sm font-semibold text-white lg:flex">
      {
        items.map((item) => (
          <a href={item.href} class="transition-opacity duration-200 hover:opacity-70">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center border-b px-3 py-1 transition-opacity duration-200 hover:opacity-70">
      <div class="hidden items-center gap-8 lg:flex">
        <a href="/curriculo">
          <span class="text-sm font-semibold">CV</span> ↗
        </a>
      </div>
    </div>

    <MobileMenu client:load isToolsPage={isToolsPage} />
  </div>
</header>
