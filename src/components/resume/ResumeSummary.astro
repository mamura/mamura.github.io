---
import { FileText } from 'lucide-react';

interface Props {
  summary: string[];
}

const {
  summary,
} = Astro.props;
---

<section class="resume-section">
  <div class="resume-section__heading">
    <FileText
      size={20}
      strokeWidth={1.8}
      aria-hidden="true"
    />

    <h2>RESUMO PROFISSIONAL</h2>
  </div>

  <div class="resume-summary__content">
    {
      summary.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>
</section>