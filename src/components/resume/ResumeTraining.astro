---
import { Bookmark } from 'lucide-react';

import { courses } from '@/data/resume/courses';
---

<section class="resume-training">
  <div class="resume-section__heading">
    <Bookmark
      size={20}
      strokeWidth={1.8}
      aria-hidden="true"
    />

    <h2>FORMAÇÃO COMPLEMENTAR</h2>
  </div>

  <div class="resume-training__list">
    {
      courses.map((course) => (
        <article class="resume-training__item">
          <span class="resume-training__year">
            {course.year}
          </span>

          <span class="resume-training__name">
            {course.name}
          </span>

          <span class="resume-training__institution">
            {course.institution}
          </span>
        </article>
      ))
    }
  </div>
</section>