---
import { FolderGit2 } from 'lucide-react';

import { projects } from '@/data/resume/projects';
---

<section class="resume-projects">
  <div class="resume-section__heading">
    <FolderGit2
      size={20}
      strokeWidth={1.8}
      aria-hidden="true"
    />

    <h2>PROJETOS EM DESTAQUE</h2>
  </div>

  <div class="resume-projects__list">
    {
      projects.map((project) => (
        <article class="resume-projects__item">
          <img
            src={project.icon}
            alt=""
            class="resume-projects__icon"
            aria-hidden="true"
          />

          <div class="resume-projects__content">
            <h3>{project.name}</h3>

            <p>{project.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>