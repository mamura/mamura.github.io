---
import { History } from 'lucide-react';

import type { Experience } from '@/data/resume/types';

interface Props {
  experiences: Experience[];
}

const { experiences: previousExperiences } = Astro.props;

const monthNames = [
  'Jan',
  'Fev',
  'Mar',
  'Abr',
  'Mai',
  'Jun',
  'Jul',
  'Ago',
  'Set',
  'Out',
  'Nov',
  'Dez',
];

function formatDate(date: string) {
  if (!date.includes('-')) {
    return date;
  }

  const [year, month] = date.split('-');

  return `${monthNames[Number(month) - 1]} ${year}`;
}

function formatPeriod(start: string, end?: string) {
  const startLabel = formatDate(start);
  const endLabel = end ? formatDate(end) : 'Atual';

  return `${startLabel} — ${endLabel}`;
}
---

<section class="resume-previous-experience">
  <div class="m-container">
    <div class="resume-section__heading">
      <History
        size={20}
        strokeWidth={1.8}
        aria-hidden="true"
      />

      <h2>EXPERIÊNCIA ANTERIOR</h2>
    </div>

    <div class="resume-previous-experience__grid">
      {
        previousExperiences.map((experience) => (
          <article class="resume-previous-experience__item">
            <div class="resume-previous-experience__period">
              {formatPeriod(
                experience.period.start,
                experience.period.end,
              )}
            </div>

            <div class="resume-previous-experience__content">
              <h3>{experience.company}</h3>

              <p class="resume-previous-experience__role">
                {experience.role}
              </p>

              {
                experience.engagements.map((engagement) => (
                  <div class="resume-previous-experience__engagement">
                    {
                      (engagement.client || engagement.project) && (
                        <p class="resume-previous-experience__project">
                          {engagement.client}

                          {
                            engagement.project && (
                              <>
                                {engagement.client && ' — '}
                                {engagement.project}
                              </>
                            )
                          }
                        </p>
                      )
                    }

                    {
                      engagement.context && (
                        <p class="resume-previous-experience__context">
                          {engagement.context}
                        </p>
                      )
                    }

                    {
                      engagement.technologies.length > 0 && (
                        <p class="resume-previous-experience__technologies">
                          {engagement.technologies.join(' · ')}
                        </p>
                      )
                    }
                  </div>
                ))
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>