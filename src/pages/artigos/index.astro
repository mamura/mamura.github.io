---
import { getCollection } from 'astro:content';
import { formatArticleDate } from '@/utils/date';

import Header from '@/components/layout/Header.astro';

import '@/styles/global.css';
import '@/styles/articles.css';
import PageHero from '@/components/layout/PageHero.astro';
import AdSense from '@/components/article/AdSense.astro';

const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Artigos sobre desenvolvimento de software, arquitetura, inteligência artificial, produto e tecnologia."
    />

    {import.meta.env.PROD && (
      <script
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token":"52fd7be7afa3439780ca628a71be99ba"}'
      ></script>
    )}

    <!-- Google AdSense -->

    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3431355971358033"
      crossorigin="anonymous"
    ></script>

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Mamura.dev"
      href="/rss.xml"
    />

    <title>Artigos | Mamura</title>
  </head>

  <body>
    <main class="min-h-screen bg-background text-white">
      <Header />

      <PageHero
        backgroundImage="/images/pages/artigos.jpg"
        variant="image"
        description="Desenvolvimento de software, arquitetura, inteligência artificial, produto e os problemas que aparecem no caminho."
      >
        <Fragment slot="title">
          Ideias, experiências e coisas que aprendi <strong>construindo.</strong>
        </Fragment>
      </PageHero>

      <section class="articles-page">
        <div class="m-container">
          <div class="articles-page__list">
            {
              articles.map((article) => (
                <a
                  href={`/artigos/${article.id}`}
                  class="article-list-item"
                >
                  <div class="article-list-item__image-wrapper">
                    <img
                      src={article.data.cover}
                      alt=""
                      class="article-list-item__image"
                      loading="lazy"
                    />
                  </div>

                  <div class="article-list-item__content">
                    <div class="article-list-item__meta">
                      <span>{article.data.category}</span>

                      <span
                        class="article-list-item__separator"
                        aria-hidden="true"
                      ></span>

                      <time datetime={article.data.publishedAt.toISOString()}>
                        { formatArticleDate(article.data.publishedAt) }
                      </time>
                    </div>

                    <h2 class="article-list-item__title">
                      {article.data.title}
                    </h2>

                    <p class="article-list-item__description">
                      {article.data.description}
                    </p>

                    <span class="article-list-item__link">
                      Ler artigo →
                    </span>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </main>
  </body>
</html>