---
import SmartGoalGenerator from '@/components/tools/smart-goals/SmartGoalGenerator';
import Header from '@/components/layout/Header.astro';
import PageHero from '@/components/layout/PageHero.astro';

import '@/styles/global.css';
import '@/styles/hero.css';
import '@/styles/tools.css';
import '@/styles/smart-goals.css';
import ToolHeader from '@/components/tools/ToolHeader.astro';
interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, bodyClass, image = '/images/articles/logo.png', imageAlt = 'Mamura.dev' } = Astro.props;
const pageTitle = `${title} | Mamura.dev`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site!);
const imageUrl = new URL(image, Astro.site!);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={imageUrl.toString()} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content="Mamura.dev" />
    <meta property="og:locale" content="pt_BR" />
    <link rel="alternate" type="application/rss+xml" title="Mamura.dev" href="/rss.xml" />
    {import.meta.env.PROD && (
      <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token":"52fd7be7afa3439780ca628a71be99ba"}'></script>
    )}
  </head>
  <body class={bodyClass}>
    <a class="tools-skip-link" href="#tools-content">Pular para o conteúdo</a>
    <Header />
    <main id="tools-content" class="tools-page" tabindex="-1">
      <ToolHeader
        title="Gerador de Metas SMART."
        description="Transforme seus objetivos em metas claras, mensuráveis e com prazo definido."
        breadcrumbs={[
          {
            label: 'Ferramentas',
            href: '/ferramentas/',
          },
          {
            label: 'Metas SMART',
          },
        ]}
      >
        <Fragment slot="title">
          Gerador de Metas <strong>SMART.</strong>
        </Fragment>
      </ToolHeader>

      <div class="m-container">
        <section class="tool-content">
          <SmartGoalGenerator client:load />
        </section>

        <noscript><p>Ative o JavaScript no navegador para preencher o formulário guiado.</p></noscript>
      </div>
    </main>
  </body>
</html>